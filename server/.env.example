# Port to listen on (Render sets this automatically).
PORT=8080
# Comma-separated browser origins allowed by CORS; "*" matches one sub-domain label.
# Empty = allow all (fine for local development only).
CLIENT_ORIGIN=http://localhost:5173
# Optional overrides
# UPSTREAM_USER_AGENT=Atmos-Weather/1.0 (+https://github.com/you/weather-app)
# OVERPASS_URLS=https://overpass-api.de/api/interpreter
# RATE_LIMIT_PER_MINUTE=120
